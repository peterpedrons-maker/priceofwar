rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (Firebase Auth UID)
    // Fields:
    //   - uid: string (required, immutable) - Firebase Auth UID
    //   - email: string (required, immutable) - User email
    //   - displayName: string (optional) - Display name
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
       return request.auth != null;
    }

    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
       return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
       return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser(data) {
       return hasOnlyAllowedFields(['uid', 'email', 'displayName']) &&
              data.uid is string &&
              data.email is string &&
              (data.displayName is string || !('displayName' in data));
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasRequiredFields(['uid', 'email']) && isValidUser(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == resource.data.uid;
    }

    match /games/{gameId} {
      allow read: if isAuthenticated() && (resource.data.player1Id == request.auth.uid || resource.data.player2Id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.player1Id == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.player1Id == request.auth.uid || resource.data.player2Id == request.auth.uid);
    }
  }
}
