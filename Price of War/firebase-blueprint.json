{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "displayName": { "type": "string", "description": "Display name" }
      },
      "required": ["uid", "email"]
    }
  },
{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "displayName": { "type": "string", "description": "Display name" }
      },
      "required": ["uid", "email"]
    },
    "Game": {
      "title": "Game",
      "description": "Multiplayer game state",
      "type": "object",
      "properties": {
        "player1Id": { "type": "string", "description": "Player 1 UID" },
        "player2Id": { "type": "string", "description": "Player 2 UID" },
        "gameState": { "type": "string", "description": "Serialized game state" },
        "status": { "type": "string", "description": "Game status (waiting, active, finished)" }
      },
      "required": ["player1Id", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "Game" },
      "description": "Multiplayer games"
    }
  }
}
